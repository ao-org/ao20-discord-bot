{
  "name": "ao20-discord-bot",
  "type": "module",
  "version": "1.0.0",
  "description": "Bot for Argentum 20 discord server.",
  "scripts": {
    "prettier": "prettier --write .",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js __tests__"
  },
  "author": "Bruno De Angelis (SimP) & Alejo Burnowicz (Centorios)",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "^16.4.7",
    "prettier": "^3.9.6"
  }
}
