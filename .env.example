DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_ID
GUILD_ID=YOUR_TEST_SERVER_ID
ZABBIX_URL=https://zabbix.example.com/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=YOUR_ZABBIX_READ_TOKEN
ZABBIX_ITEM_ID=46595
ZABBIX_POLL_INTERVAL_MS=15000
# Abort a stalled Zabbix request so the next polling cycle can recover.
ZABBIX_REQUEST_TIMEOUT_MS=10000
# Set false to ignore the current Zabbix backlog on startup.
ZABBIX_PROCESS_EXISTING_LOGS=false
AI_URL=https://llm.example.com/v1/chat/completions
AI_TOKEN=YOUR_AI_TOKEN
AI_MODEL=default
OTEL_SERVICE_NAME=ao20-discord-bot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Channel variable suffixes are the log names with punctuation replaced by _.
DISCORD_LOG_CHANNEL_DATABASE_LOG=YOUR_CHANNEL_ID
